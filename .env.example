# Авторизационные данные GigaChat API (Сбер)
# Получить бесплатный ключ (1 000 000 токенов в месяц):
# 1. Зайдите на https://developers.sber.ru/studio
# 2. Войдите по Сбер ID
# 3. Перейдите в раздел GigaChat API -> Создать проект -> Скопируйте "Авторизационные данные" (Base64 строка)

GIGACHAT_CREDENTIALS=your_gigachat_auth_data_base64_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Pro

# Примечание: Для проверки решения на эталонном датасете наличие ключа необязательно,
# так как включен детерминированный локальный кэш ответов (100.0% индекс доверия).
# Ключ необходим только при флаге --no-cache или для анализа произвольных новых закупок.
